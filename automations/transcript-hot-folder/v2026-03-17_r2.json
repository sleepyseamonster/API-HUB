        "jsCode": "const items = $input.all().map((entry) => entry.json);\nif (!items.length) {\n  return [{ json: {\n    status: 'skipped_duplicate',\n    message: 'No chunks to write.',\n    workflow_version: 'v2026-03-17_r2',\n    chunks_generated: 0,\n    chunks_inserted: 0\n  }}];\n}\nconst first = items[0];\nconst inserted = items.filter((item) => item.inserted).length;\nconst generated = Number(first.generated_chunk_count ?? items.length);\nconst workflowVersion = first.workflow_version ?? 'v2026-03-17_r2';\nreturn [{ json: {\n  status: inserted > 0 ? 'success' : 'skipped_duplicate',\n  message: inserted > 0 ? 'Transcript processed successfully.' : 'All generated chunks already existed.',\n  workflow_version: workflowVersion,\n  meta: {\n    workflow_version: workflowVersion,\n    source: 'n8n'\n  },\n  file_fingerprint: first.fingerprint,\n  source_filename: first.source_filename,\n  batch_id: first.batch_id,\n  chunks_generated: generated,\n  chunks_inserted: inserted,\n  duplicate_reason: inserted > 0 ? null : 'all_chunk_ids_already_exist'\n}}];"
