        "jsCode": "const item = $input.item;\nconst binary = item.binary ?? {};\nconst file = binary.file;\nif (!file) {\n  throw new Error('Missing uploaded file in binary.file');\n}\nconst body = item.json ?? {};\nfor (const key of ['batch_id', 'source_filename', 'source_relative_path', 'fingerprint', 'dropped_at']) {\n  if (!body[key]) {\n    throw new Error(`Missing required field: ${key}`);\n  }\n}\nconst extension = String(body.source_filename).toLowerCase().split('.').pop();\nif (!['txt', 'md'].includes(extension)) {\n  throw new Error(`Unsupported extension: ${extension}`);\n}\nitem.json = {\n  batch_id: String(body.batch_id),\n  source_filename: String(body.source_filename),\n  source_relative_path: String(body.source_relative_path),\n  fingerprint: String(body.fingerprint),\n  dropped_at: String(body.dropped_at),\n  content_type: String(body.content_type ?? file.mimeType ?? ''),\n};\nreturn item;"
