    {
      "parameters": {
  "jsCode": "const response = $input.item.json;\nconst raw = response.output?.[0]?.content?.[0]?.text ?? response.text ?? response;\nconst payload = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst chunks = Array.isArray(payload) ? payload : payload.chunks;\nif (!Array.isArray(chunks)) {\n  throw new Error('Model did not return a chunks array');\n}\nconst workflowVersion = 'v2026-03-17_r2';\nif (!chunks.length) {\n  return [{ json: {\n    status: 'skipped_duplicate',\n    message: 'No usable transcript chunks were produced.',\n    workflow_version: workflowVersion,\n    batch_id: $('Validate Request').item.json.batch_id,\n    source_filename: $('Validate Request').item.json.source_filename,\n    file_fingerprint: $('Validate Request').item.json.fingerprint,\n    chunks_generated: 0,\n    chunks_inserted: 0,\n    duplicate_reason: 'empty_transcript'\n  }}];\n}\nfunction slug(value) {\n  return String(value ?? '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 48) || 'chunk';\n}\nfunction hash(value) {\n  let h = 5381;\n  for (const char of String(value)) {\n    h = ((h << 5) + h) + char.charCodeAt(0);\n  }\n  return Math.abs(h).toString(36);\n}\nconst source = $('Validate Request').item.json;\nreturn chunks.map((chunk, index) => {\n  const metadata = chunk.metadata ?? {};\n  const pageContent = String(chunk.pageContent ?? '').trim();\n  if (!pageContent) {\n    throw new Error(`Chunk ${index + 1} is missing pageContent`);\n  }\n  const stableId = `${slug(metadata.topic || chunk.id || source.source_filename)}_${hash(`${source.fingerprint}:${pageContent}`)}`;\n  return {\n    json: {\n      id: stableId,\n      pageContent,\n      workflow_version: workflowVersion,\n      metadata: {\n        week: metadata.week ?? null,\n        topic: metadata.topic ?? 'Transcript',\n        subtopic: metadata.subtopic ?? source.source_filename,\n        concept_type: metadata.concept_type ?? 'Instructional Guidance',\n        complexity_level: metadata.complexity_level ?? 'Foundational',\n        content_category: metadata.content_category ?? 'Transcript Chunk',\n        retrieval_tags: Array.isArray(metadata.retrieval_tags) ? metadata.retrieval_tags.join(', ') : String(metadata.retrieval_tags ?? '')\n      },\n      batch_id: source.batch_id,\n      source_filename: source.source_filename,\n      fingerprint: source.fingerprint,\n      generated_chunk_count: chunks.length\n    }\n  };\n});"
      },
