# Transcript hot-folder watcher environment

N8N_TRANSCRIPT_WEBHOOK_URL=https://<your-n8n-host>/webhook/transcript-hot-folder-intake
N8N_TRANSCRIPT_WEBHOOK_AUTH_HEADER=X-Internal-Webhook-Secret
N8N_TRANSCRIPT_WEBHOOK_AUTH_TOKEN=<internal-webhook-secret>

TRANSCRIPT_HOT_FOLDER_ROOT=/absolute/path/to/API HUB/Kirk's Folder/automation-bay/transcripts
TRANSCRIPT_HOT_FOLDER_SCAN_INTERVAL=5
TRANSCRIPT_HOT_FOLDER_STABLE_SECONDS=4
TRANSCRIPT_HOT_FOLDER_REQUEST_TIMEOUT=120
TRANSCRIPT_HOT_FOLDER_RETRY_ATTEMPTS=2
TRANSCRIPT_HOT_FOLDER_RETRY_DELAY_SECONDS=2

# Optional convenience command:
# python3 backend/tools/transcript_hot_folder_watcher.py doctor
